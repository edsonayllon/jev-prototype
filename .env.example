# Firebase web app config — Firebase console → Project settings → Your apps → Web app.
# Leave empty to run purely against the local emulators.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise site key). Firebase console → App Check → Apps → your web app.
# The deployed function rejects calls without it; ignored when VITE_USE_EMULATORS=true.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development: point the client at `npm run emulators` (no real project needed).
VITE_USE_EMULATORS=true
