# Firebase web app config — Firebase console → Project settings → Your apps → Web app.
# Leave empty to run purely against the local emulators.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development: point the client at `npm run emulators` (no real project needed).
VITE_USE_EMULATORS=true
